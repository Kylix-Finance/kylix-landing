{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "#/*": ["public/*"],
      "~/*": ["src/*"]
    },
    "noEmit": true
  },
  "include": [
    "./react-app-env.d.ts",
    "src",
    ".next/types/**/*.ts",
    "../../theme.d.ts",
    "../../global.d.ts"
  ],
  "exclude": [
    "node_modules",
    "src/app/_parts/Hero/components/Scene.tsx",
    "src/app/_parts/Hero/components/Camera.tsx",
    "src/app/_parts/Hero/components/Jar.tsx",
    "src/app/_parts/Hero/components/Hero3D.tsx"
  ]
}
